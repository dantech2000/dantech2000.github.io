---
interface Props {
  active?: boolean;
  class?: string;
}
const { active = false, class: className } = Astro.props;
---

<svg width="28" height="18" viewBox="0 0 28 18" class={className} aria-hidden="true">
  <g style={`fill: var(${active ? '--color-signal' : '--color-line-strong'})`}>
    <rect x="0" y="12" width="4" height="6"></rect>
    <rect x="8" y="8" width="4" height="10"></rect>
    <rect x="16" y="4" width="4" height="14"></rect>
    <rect x="24" y="0" width="4" height="18"></rect>
  </g>
</svg>
