---
import Base from '~/layouts/Base.astro';
---

<Base title="Signal lost">
  <section class="dr-grid-bg dr-scan relative overflow-hidden border-b border-line">
    <div class="dr-scanbar"></div>
    <div class="dr-wrap relative z-[2] flex flex-col gap-8 py-24 lg:py-32">
      <div class="dr-titleblock">
        <span class="dr-eyebrow">Error // 404 — NXDOMAIN</span>
        <h1 class="t-display-3 lg:t-display-1 dr-jitter">
          <span class="dr-glitch" data-text="Signal">Signal</span><br /><span
            class="dr-glitch text-signal"
            data-text="lost">lost</span
          >
        </h1>
      </div>
      <p class="t-body lg:t-body-l">This page doesn't exist. It may have moved when the site was rebuilt.</p>
      <a class="dr-btn dr-btn--primary self-start" href="/">Back to home <span aria-hidden="true">→</span></a>
    </div>
    <div class="dr-hazard absolute right-0 bottom-0 left-0 z-[5] h-2 lg:h-2.5"></div>
  </section>
</Base>
